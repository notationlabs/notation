{
  "type": "module",
  "name": "@notation/cloudflare",
  "version": "0.24.0",
  "sideEffects": false,
  "exports": {
    "./workers": {
      "types": "./dist/workers/index.d.ts",
      "notation-runtime": "./dist/workers/runtime.js",
      "import": "./dist/workers/index.js"
    },
    "./resources": {
      "types": "./dist/resources/index.d.ts",
      "default": "./dist/resources/index.js"
    },
    "./kv": {
      "types": "./dist/kv/index.d.ts",
      "default": "./dist/kv/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test:e2e": "vitest run --root ../.. --config vitest.e2e.config.ts --project e2e packages/cloudflare/",
    "test:e2e-slow": "vitest run --root ../.. --config vitest.e2e.config.ts --project slow packages/cloudflare/"
  },
  "dependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "@notation/core": "workspace:*",
    "@notation/resource": "workspace:*",
    "@notation/std": "workspace:*",
    "@notation/utils": "workspace:*",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@aws-sdk/client-ecr": "^3.1168.0",
    "@notation/cli": "workspace:*",
    "@notation/reconciler": "workspace:*",
    "@notation/test-utils": "workspace:*"
  }
}
