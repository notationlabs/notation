{
  "type": "module",
  "name": "@notation/aws",
  "version": "0.16.0",
  "sideEffects": false,
  "exports": {
    "./lambda": {
      "types": "./dist/lambda/index.d.ts",
      "notation-runtime": "./dist/lambda/runtime.js",
      "import": "./dist/lambda/index.js"
    },
    "./*": {
      "import": "./dist/*/index.js",
      "types": "./dist/*/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@notation/aws.iac": "workspace:*",
    "@notation/core": "workspace:*",
    "@notation/resource": "workspace:*",
    "@notation/std.iac": "workspace:*",
    "@types/aws-lambda": "^8.10.147",
    "aws-jwt-verify": "^5.0.0"
  },
  "devDependencies": {
    "@notation/reconciler": "workspace:*",
    "@notation/state": "workspace:*"
  }
}
