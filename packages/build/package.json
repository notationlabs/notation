{
  "type": "module",
  "name": "@notation/build",
  "version": "0.26.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./resources": {
      "types": "./dist/resources/index.d.ts",
      "default": "./dist/resources/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@notation/core": "workspace:*",
    "@notation/resource": "workspace:*",
    "fflate": "0.8.3",
    "magic-string": "^0.30.21",
    "rolldown": "^1.3.0"
  }
}
