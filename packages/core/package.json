{
  "type": "module",
  "name": "@notation/core",
  "version": "0.19.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@notation/durable": "0.9.0",
    "@notation/reconciler": "workspace:*",
    "@notation/resource": "workspace:*",
    "@notation/state": "workspace:*",
    "@notation/utils": "workspace:*",
    "esbuild": "^0.25.12",
    "js-base64": "^3.9.6",
    "lodash-es": "^4.18.1",
    "pako": "^2.2.0",
    "pino": "^9.14.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/common-tags": "^1.8.4",
    "@types/lodash-es": "^4.17.12",
    "@types/pako": "^2.0.4",
    "common-tags": "^1.8.2"
  }
}
